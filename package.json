{
  "name": "ops-copilot",
  "version": "0.1.0",
  "private": true,
  "description": "Copiloto de operações: investiga incidentes e propõe ações dentro de limites de autonomia definidos em código.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "dev": "tsx src/main.ts",
    "eval": "tsx evals/run.ts",
    "validate:playbooks": "tsx src/cli/validate-playbooks.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@kubernetes/client-node": "^2.0.2",
    "@langchain/core": "^1.5.0",
    "@langchain/langgraph": "^1.7.5",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/context-async-hooks": "^3.1.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/resources": "^3.1.1",
    "@opentelemetry/sdk-trace": "^3.1.1",
    "@opentelemetry/semantic-conventions": "^1.45.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.18",
    "minisearch": "^7.2.0",
    "pino": "^10.4.0",
    "prom-client": "^15.1.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
