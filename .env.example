# Copie para .env e ajuste. Valores "dev-only" servem só para o ambiente local.

# --- Copiloto ---------------------------------------------------------------
PORT=8080
LOG_LEVEL=info
EXECUTION_MODE=dry-run
# Precisam ter 16+ caracteres e ser diferentes entre si.
# WEBHOOK_TOKEN tem que bater com deploy/alertmanager/alertmanager.yml.
WEBHOOK_TOKEN=dev-only-webhook-token-change-me
APPROVAL_TOKEN=dev-only-approval-token-change-me
APPROVAL_TTL_MINUTES=30
# Orçamento, aprovações e incidentes (ADR 0011). Vazio = em memória, perdidos no restart.
REDIS_URL=redis://localhost:6379

# --- Fontes de sinais (pnpm dev no host usa as portas publicadas pelo compose) ---
PROMETHEUS_URL=http://localhost:9090
JAEGER_URL=http://localhost:16686
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- LLM: ollama (local, custo zero), openrouter ou scripted (roteirizado, só demonstração) ---
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
# OPENROUTER_API_KEY=
# Para OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1 (e o mesmo em COPILOT_LLM_BASE_URL)
# Endereço do LLM visto de dentro do contêiner do copiloto (make up):
COPILOT_LLM_BASE_URL=http://host.docker.internal:11434/v1

# --- Trilha de auditoria: file (JSONL local) ou s3 (MinIO/AWS com object lock) ---
AUDIT_SINK=file
AUDIT_LOG_PATH=var/audit.jsonl
AUDIT_S3_BUCKET=ops-copilot-audit
AUDIT_S3_PREFIX=audit/
AUDIT_RETENTION_DAYS=30
AWS_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000

# --- MinIO local (somente desenvolvimento) ----------------------------------
MINIO_ROOT_USER=ops-copilot-admin
MINIO_ROOT_PASSWORD=dev-only-change-me
AUDIT_WRITER_ACCESS_KEY=audit-writer
AUDIT_WRITER_SECRET_KEY=dev-only-audit-writer-change-me

# --- Portas publicadas no host (mude se já estiverem em uso) ----------------
COPILOT_PORT=8080
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
JAEGER_UI_PORT=16686
JAEGER_OTLP_PORT=4318
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_PORT=6379

# --- Modo ecossistema (make up-portfolio) -----------------------------------
PORTFOLIO_PROMETHEUS_URL=http://platform-edge-prometheus-1:9090
PORTFOLIO_JAEGER_URL=http://platform-edge-jaeger-1:16686
PORTFOLIO_OTLP_ENDPOINT=http://platform-edge-jaeger-1:4318
