# Copie para .env e ajuste. Valores "dev-only" servem só para o ambiente local.

# --- Copiloto ---------------------------------------------------------------
PORT=8080
LOG_LEVEL=info
EXECUTION_MODE=dry-run
# Modo live (ADR 0014): tudo explícito. Nunca é lido o kubeconfig padrão da máquina.
# EXECUTOR_TARGETS_FILE=config/executor-targets.yaml
# KUBE_AUTH=in-cluster            # ou kubeconfig, com KUBECONFIG_PATH e KUBE_CONTEXT
# FEATURE_FLAGS_URL=
# FEATURE_FLAGS_TOKEN=
# DLQ_REDIS_URL=
# Precisam ter 16+ caracteres; nenhum token de operador pode ser igual ao do webhook.
# WEBHOOK_TOKEN tem que bater com deploy/alertmanager/alertmanager.yml.
WEBHOOK_TOKEN=dev-only-webhook-token-change-me
# Um token por operador (e-mail=token[:approver]): a identidade vem do token e assina aprovações, recusas, cancelamentos e rollbacks.
# Sem sufixo o papel é leitor (só consulta); :approver também decide (ADR 0016). OIDC: papel OIDC_APPROVER_ROLE.
# OIDC opcional: com OIDC_ISSUER_URL (Keycloak) o copiloto aceita também access tokens JWT.
OPERATOR_TOKENS=plantonista@example.com=dev-only-operador-plantao:approver,lider@example.com=dev-only-operador-lider:approver,leitor@example.com=dev-only-operador-leitor
# OIDC_ISSUER_URL=http://localhost:8180/realms/platform
# OIDC_AUDIENCE=ops-copilot
# OIDC_CLIENT_ID=ops-copilot-web
# Jaeger visto pelo navegador (link do trace no painel) e commit mostrado na tela de política.
JAEGER_PUBLIC_URL=http://localhost:16686
# GIT_COMMIT=
APPROVAL_TTL_MINUTES=30
# Orçamento, aprovações e incidentes (ADR 0011). Vazio = em memória, perdidos no restart.
REDIS_URL=redis://localhost:6379

# --- ChatOps no Slack (ADR 0019): vazio desliga ---------------------------------
# Rota POST /chatops/slack/interactions (URL de interatividade do app). Só decide quem está em SLACK_USERS
# (IDSlack=e-mail[:approver]); sem :approver o usuário é leitor e não decide.
# SLACK_SIGNING_SECRET=
# SLACK_USERS=U0EXAMPLE1=plantonista@example.com:approver
# SLACK_BOT_TOKEN=            # avisa o plantão (notify_oncall) e publica os pedidos com botões
# SLACK_APPROVAL_CHANNEL=#aprovacoes
# O compose repassa estas variáveis; vazio = desligado.

# --- Fontes de sinais (pnpm dev no host usa as portas publicadas pelo compose) ---
PROMETHEUS_URL=http://localhost:9090
JAEGER_URL=http://localhost:16686
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# --- LLM: ollama (local, custo zero), openrouter ou scripted (roteirizado, só demonstração) ---
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
# OPENROUTER_API_KEY=
# Teto de custo de LLM por incidente, em dólares (ADR 0016); passado o teto, o diagnóstico falha e vai para humanos.
LLM_MAX_COST_USD_PER_INCIDENT=0.25
# Para OpenRouter: LLM_BASE_URL=https://openrouter.ai/api/v1 (e o mesmo em COPILOT_LLM_BASE_URL)
# Endereço do LLM visto de dentro do contêiner do copiloto (make up):
COPILOT_LLM_BASE_URL=http://host.docker.internal:11434/v1

# --- Trilha de auditoria: file (JSONL local) ou s3 (MinIO/AWS com object lock) ---
AUDIT_SINK=file
AUDIT_LOG_PATH=var/audit.jsonl
AUDIT_S3_BUCKET=ops-copilot-audit
AUDIT_S3_PREFIX=audit/
AUDIT_RETENTION_DAYS=30
AWS_REGION=us-east-1
# S3_ENDPOINT=http://localhost:9000

# --- MinIO local (somente desenvolvimento) ----------------------------------
MINIO_ROOT_USER=ops-copilot-admin
MINIO_ROOT_PASSWORD=dev-only-change-me
AUDIT_WRITER_ACCESS_KEY=audit-writer
AUDIT_WRITER_SECRET_KEY=dev-only-audit-writer-change-me

# --- Portas publicadas no host (mude se já estiverem em uso) ----------------
COPILOT_PORT=8080
WEB_PORT=8088
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
JAEGER_UI_PORT=16686
JAEGER_OTLP_PORT=4318
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
REDIS_PORT=6379

# --- Modo ecossistema (make up-portfolio) -----------------------------------
PORTFOLIO_PROMETHEUS_URL=http://platform-edge-prometheus-1:9090
PORTFOLIO_JAEGER_URL=http://platform-edge-jaeger-1:16686
PORTFOLIO_OTLP_ENDPOINT=http://platform-edge-jaeger-1:4318
